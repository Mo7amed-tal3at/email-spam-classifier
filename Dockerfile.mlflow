FROM python:3.12-slim

RUN pip install --no-cache-dir mlflow

WORKDIR /mlflow

EXPOSE 5000

CMD ["mlflow", "server", \
     "--host", "0.0.0.0", \
     "--port", "5000", \
     "--backend-store-uri", "sqlite:///mlflow.db", \
     "--artifacts-destination", "./mlartifacts", \
     "--allowed-hosts", "mlflow,mlflow:5000,localhost,127.0.0.1"]